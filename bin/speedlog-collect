#!/usr/bin/env bash
set -euo pipefail

# speedlog-collect — run a speed test and append results to CSV
# https://github.com/omar16100/speedlog
#
# CSV schema (8 columns):
#   timestamp,ping_ms,download_mbit,upload_mbit,isp,server,status,server_id
#
# `status` distinguishes a failing connection from a failing measurement tool.
# Without it every non-zero exit looks like an outage, which badly overstates
# the error rate: most failures are Ookla's own config and server-selection
# endpoints, not the line under test.

SPEEDLOG_DATA_DIR="${SPEEDLOG_DATA_DIR:-$HOME/.local/share/speedlog}"
LOG_FILE="$SPEEDLOG_DATA_DIR/speedtest_log.csv"
ERROR_LOG="$SPEEDLOG_DATA_DIR/speedtest_error.log"

# Pin a server to keep the series comparable with itself. Ookla's automatic
# choice moves between endpoints whose medians differ by more than 10 Mbit,
# which shows up as line variance that is really measurement variance.
SPEEDLOG_SERVER_ID="${SPEEDLOG_SERVER_ID:-}"

# Most failures are transient and clear within a minute. Overridable so the
# tests do not have to sit through the real delay.
SPEEDLOG_RETRY_DELAY="${SPEEDLOG_RETRY_DELAY:-60}"

CSV_HEADER="timestamp,ping_ms,download_mbit,upload_mbit,isp,server,status,server_id"

# Detect speedtest binary
SPEEDTEST_BIN="${SPEEDTEST_BIN:-$(command -v speedtest 2>/dev/null || true)}"

if [[ -z "$SPEEDTEST_BIN" ]]; then
    echo "[ERROR] speedtest CLI not found. Install from https://www.speedtest.net/apps/cli" >&2
    exit 1
fi

# Verify it's the Ookla binary (not sivel/speedtest-cli)
if ! "$SPEEDTEST_BIN" --version 2>/dev/null | grep -qi "ookla"; then
    echo "[ERROR] Found '$SPEEDTEST_BIN' but it doesn't appear to be the Ookla Speedtest CLI." >&2
    echo "        Install the official CLI from https://www.speedtest.net/apps/cli" >&2
    exit 1
fi

# Check for jq
if ! command -v jq &>/dev/null; then
    echo "[ERROR] jq not found. Install with: brew install jq (macOS) or apt install jq (Linux)" >&2
    exit 1
fi

# A server id ends up interpolated into the CSV; a comma in it would widen the
# row and silently corrupt the schema.
if [[ -n "$SPEEDLOG_SERVER_ID" && ! "$SPEEDLOG_SERVER_ID" =~ ^[0-9]+$ ]]; then
    echo "[ERROR] SPEEDLOG_SERVER_ID must be numeric, got '$SPEEDLOG_SERVER_ID'" >&2
    exit 1
fi

# Ensure data directory exists
mkdir -p "$SPEEDLOG_DATA_DIR"

# Create CSV header if file doesn't exist
if [[ ! -f "$LOG_FILE" ]]; then
    echo "$CSV_HEADER" > "$LOG_FILE"
else
    # Appending 8-column rows under an older header makes a mixed-schema file
    # that reads fine here and lies to every other tool. Warn rather than
    # rewrite: the header is the user's data, not ours.
    EXISTING_HEADER=$(head -1 "$LOG_FILE")
    if [[ "$EXISTING_HEADER" != "$CSV_HEADER" ]]; then
        echo "[WARN] $LOG_FILE header is '$EXISTING_HEADER'," >&2
        echo "       expected '$CSV_HEADER'. Appending anyway; fix the header to avoid a mixed-schema file." >&2
    fi
fi

# Only one measurement at a time. The hourly cron job and the dashboard's
# on-demand POST /api/run-test both invoke this script, and two speed tests
# running together saturate the line against each other: both rows land marked
# `ok` carrying meaningless bandwidth. macOS has no flock(1), so use mkdir,
# which is atomic on every POSIX filesystem.
LOCK_DIR="$SPEEDLOG_DATA_DIR/.collect.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    # A crash can leave the directory behind. Reap it if it is clearly stale,
    # otherwise defer to the run that holds it.
    if [[ -n $(find "$LOCK_DIR" -maxdepth 0 -mmin +30 2>/dev/null) ]]; then
        echo "[WARN] removing stale lock $LOCK_DIR (older than 30 min)" >&2
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" 2>/dev/null || { echo "[ERROR] could not acquire lock" >&2; exit 1; }
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] another speedlog-collect is running, skipping" >&2
        exit 1
    fi
fi

# Map Ookla's error text onto a stable class. The CLI emits both bare bracket
# lines and structured JSON log lines; both carry the same phrases.
classify_error() {
    local text="$1"
    if [[ "$text" == *"Could not retrieve or read configuration"* ]] \
        || [[ "$text" == *"Cannot retrieve configuration document"* ]] \
        || [[ "$text" == *"ConfigurationError"* ]]; then
        echo "config_unavailable"
    elif [[ "$text" == *"Failed to find a working test server"* ]] \
        || [[ "$text" == *"NoServers"* ]]; then
        echo "no_servers"
    elif [[ "$text" == *"Timeout occurred in connect"* ]] \
        || [[ "$text" == *"Timeout occurred"* ]]; then
        echo "connect_timeout"
    else
        echo "unknown"
    fi
}

# One measurement attempt. Stdout is the raw JSON result on success; the
# attempt's stderr is captured so it can be classified and preserved.
run_speedtest() {
    local stderr_file="$1"
    local -a args=(--format=json --accept-license --accept-gdpr)
    if [[ -n "$SPEEDLOG_SERVER_ID" ]]; then
        args+=(--server-id "$SPEEDLOG_SERVER_ID")
    fi
    "$SPEEDTEST_BIN" "${args[@]}" 2>"$stderr_file"
}

STDERR_FILE=$(mktemp)
trap 'rm -f "$STDERR_FILE"; rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
STATUS="ok"
RESULT=""

if ! RESULT=$(run_speedtest "$STDERR_FILE"); then
    FIRST_ERROR=$(cat "$STDERR_FILE")
    cat "$STDERR_FILE" >> "$ERROR_LOG"
    echo "[$TIMESTAMP] attempt 1 failed ($(classify_error "$FIRST_ERROR")), retrying in ${SPEEDLOG_RETRY_DELAY}s" >> "$ERROR_LOG"

    sleep "$SPEEDLOG_RETRY_DELAY"

    TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
    if RESULT=$(run_speedtest "$STDERR_FILE"); then
        STATUS="ok_retry"
    else
        cat "$STDERR_FILE" >> "$ERROR_LOG"
        STATUS=$(classify_error "$(cat "$STDERR_FILE")")
        echo "$TIMESTAMP,ERROR,ERROR,ERROR,ERROR,ERROR,$STATUS,$SPEEDLOG_SERVER_ID" >> "$LOG_FILE"
        echo "[$TIMESTAMP] Speedtest failed after retry: $STATUS" | tee -a "$ERROR_LOG" >&2
        exit 1
    fi
fi

# Parse all fields in a single jq call — output as CSV-ready line.
# Commas inside isp/server names would corrupt the row, so strip them.
# Parsing must not be allowed to fail silently. The measurement has already
# been taken by this point, so an unguarded jq failure under `set -e` would
# kill the run with no CSV row and nothing in the error log: a completed
# measurement vanishing without trace, which is the same failure class this
# script exists to eliminate.
#
# The three measurements are deliberately NOT defaulted. jq raises a type
# error on `null * 100`, so a result missing `.ping.latency` fails here and is
# recorded as parse_error. Coercing a missing measurement to 0 would be worse
# than failing: a fabricated 0 ms ping is indistinguishable from a real one
# once written, and it would drag every average that reads the column.
#
# isp and server name are labels rather than measurements, so an empty string
# for them is honest and keeps the row usable.
if ! CSV_LINE=$(printf '%s' "$RESULT" | jq -r '[
    (.ping.latency * 100 | round / 100),
    (.download.bandwidth * 8 / 1000000 * 100 | round / 100),
    (.upload.bandwidth * 8 / 1000000 * 100 | round / 100),
    ((.isp // "") | gsub(","; " ")),
    ((.server.name // "") | gsub(","; " "))
] | join(",")' 2>>"$ERROR_LOG"); then
    printf '%s\n' "$RESULT" >> "$ERROR_LOG"
    echo "$TIMESTAMP,ERROR,ERROR,ERROR,ERROR,ERROR,parse_error,$SPEEDLOG_SERVER_ID" >> "$LOG_FILE"
    echo "[$TIMESTAMP] measurement succeeded but could not be parsed; raw result written to $ERROR_LOG" >&2
    exit 1
fi

SERVER_ID=$(printf '%s' "$RESULT" | jq -r '.server.id // ""' 2>/dev/null || echo "")

echo "$TIMESTAMP,$CSV_LINE,$STATUS,$SERVER_ID" >> "$LOG_FILE"

# Extract individual values for display
IFS=',' read -r PING DOWN UP ISP SERVER <<< "$CSV_LINE"
echo "[$TIMESTAMP] Ping: ${PING}ms | Down: ${DOWN} Mbps | Up: ${UP} Mbps | ISP: $ISP | Server: $SERVER ($SERVER_ID) | $STATUS"
